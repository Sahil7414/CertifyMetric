# ==============================================================================
# CertifyMetric — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and fill in real values.
# DO NOT commit real secrets, API keys, or production passwords to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Secret key used for session signing and cryptographic validation
SESSION_SECRET=replace-with-a-cryptographically-secure-random-64-character-string

# Allowed Frontend Origins for CORS (comma-separated if multiple domains)
# Example: https://certifymetric.gov.in,https://admin.certifymetric.gov.in
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# MongoDB Atlas Database Configuration (Persistent Storage)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=certifymetric

# ------------------------------------------------------------------------------
# File Uploads & Evidence Storage (Persistent Storage)
# ------------------------------------------------------------------------------
# Persistent directory for uploaded inspection evidence files:
# Set to an absolute path within your mounted volume, e.g., /data/uploads
STORAGE_DIR=./server/uploads

# ------------------------------------------------------------------------------
# Email (Brevo / Sendinblue Transactional Email)
# ------------------------------------------------------------------------------
BREVO_API_KEY=xkeysib-your-api-key-here
EMAIL_FROM_ADDRESS=noreply@certifymetric.gov.in
EMAIL_FROM_NAME=CertifyMetric

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ------------------------------------------------------------------------------
# Seed & Demo Data Controls
# ------------------------------------------------------------------------------
# Set to 'true' in development/staging to seed initial demo accounts.
# MUST be 'false' in live production to prevent unmanaged demo credentials.
SEED_DEMO_USERS=true

# Allow development header authentication bypass (x-user-id).
# STRICTLY false in production environments.
ALLOW_DEV_AUTH_BYPASS=false

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
# URL of the backend API (without trailing slash)
# Production example: https://api.certifymetric.gov.in/api
VITE_API_URL=http://localhost:4000/api

# Public Canonical URL for QR Code Verification
# Production example: https://certifymetric.gov.in
VITE_APP_URL=http://localhost:5173
