# Backend Server Environment Variables
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Session Secret (change to random 64-char string in production)
SESSION_SECRET=replace-with-a-cryptographically-secure-random-64-character-string

# Allowed Frontend Origins for CORS (comma-separated if multiple domains)
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas Connection Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=certifymetric

# Persistent File Storage Directory (e.g. /data/uploads on persistent volume)
STORAGE_DRIVER=local
STORAGE_DIR=./uploads

# Demo & Security Toggles
SEED_DEMO_USERS=false
ALLOW_DEV_AUTH_BYPASS=false
